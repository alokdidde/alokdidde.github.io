---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import heroWorkshop from "../assets/hero-workshop.png";
import { getImage } from "astro:assets";
import "@fontsource-variable/cormorant-garamond/wght.css";
import "@fontsource-variable/dm-sans/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import { site } from "../data/site";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedAt?: string;
  updatedAt?: string;
};

const {
  title,
  description = site.description,
  image,
  article = false,
  publishedAt,
  updatedAt,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const defaultOgImage = await getImage({
  src: heroWorkshop,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "center",
  format: "webp",
  quality: 82,
});
const imageURL = new URL(image || defaultOgImage.src, Astro.site);
const structuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: imageURL.href,
      datePublished: publishedAt,
      dateModified: updatedAt || publishedAt,
      mainEntityOfPage: canonicalURL.href,
      author: { "@type": "Person", name: site.name },
    }
  : {
      "@context": "https://schema.org",
      "@type": "Person",
      name: site.name,
      url: canonicalURL.origin,
      description: site.description,
      sameAs: site.social.map((item) => item.href),
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf6f1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {article && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {article && updatedAt && <meta property="article:modified_time" content={updatedAt} />}

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-ambient" aria-hidden="true">
      <span class="site-orb site-orb-one"></span>
      <span class="site-orb site-orb-two"></span>
      <span class="site-orb site-orb-three"></span>
    </div>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      const revealItems = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8%", threshold: 0.08 },
        );
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
