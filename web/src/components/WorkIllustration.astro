---
type Visual = "robotics" | "agriculture" | "retrieval" | "fulmetry" | "healthcare";

interface Props {
  id: string;
  visual: Visual;
}

const { id, visual } = Astro.props;

const titles: Record<Visual, string> = {
  robotics: "Diagram of a robot built on a stack of independent interface layers",
  agriculture: "Diagram of a field robot sensing terrain and planning a route",
  retrieval: "Diagram of a search that branches and explores before settling on an answer",
  fulmetry: "Diagram of a circuit board generated from a project description",
  healthcare: "Diagram of clinical records moving between connected systems",
};
---

<svg class="work-illustration" data-visual={visual} viewBox="0 0 640 520" preserveAspectRatio="xMidYMid slice" role="img">
  <title>{titles[visual]}</title>
  <defs>
    <linearGradient id={`visual-wash-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--visual-a)" />
      <stop offset="1" stop-color="var(--visual-b)" />
    </linearGradient>
    <linearGradient id={`visual-paper-${id}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--visual-paper-a, #f3f1ea)" />
      <stop offset="1" stop-color="var(--visual-paper-b, #dceae2)" />
    </linearGradient>
  </defs>

  <rect class="visual-paper" width="640" height="520" style={`fill: url(#visual-paper-${id})`} />
  <path
    class="visual-blob"
    style={`fill: url(#visual-wash-${id})`}
    d="M72 107C139 17 302 3 434 47c123 40 183 149 134 258-48 107-187 179-330 145C95 417 9 322 29 220c8-42 22-80 43-113Z"
  />
  <circle class="visual-orbit" cx="320" cy="260" r="185" />
  <circle class="visual-orbit visual-orbit-small" cx="320" cy="260" r="140" />

  {visual === "robotics" && (
    <g class="visual-symbol">
      <path d="M320 92V62M304 62h32" />
      <rect class="visual-fill" x="238" y="92" width="164" height="116" rx="40" />
      <circle cx="286" cy="146" r="11" />
      <circle cx="354" cy="146" r="11" />
      <path d="M298 182h44M320 208v26" />
      <rect class="visual-fill" x="206" y="234" width="228" height="54" rx="16" />
      <rect class="visual-fill" x="206" y="300" width="228" height="54" rx="16" />
      <rect class="visual-fill" x="206" y="366" width="228" height="54" rx="16" />
      <circle cx="240" cy="261" r="7" />
      <circle cx="240" cy="327" r="7" />
      <circle cx="240" cy="393" r="7" />
      <path d="M368 261h42M368 327h42M368 393h42M320 288v12M320 354v12" />
      <path class="visual-dash" d="M150 214c-40 42-44 118-8 168M490 214c40 42 44 118 8 168" />
    </g>
  )}

  {visual === "fulmetry" && (
    <g class="visual-symbol">
      <rect class="visual-fill" x="82" y="176" width="164" height="152" rx="30" />
      <path d="M160 226l-30 28 30 28M196 226l30 28-30 28" />
      <path d="M246 252h44" />
      <circle class="visual-fill" cx="306" cy="252" r="14" />
      <path d="M320 252h34" />
      <rect class="visual-fill" x="354" y="140" width="204" height="232" rx="22" />
      <circle cx="396" cy="188" r="14" />
      <circle cx="516" cy="188" r="14" />
      <circle cx="396" cy="324" r="14" />
      <circle cx="516" cy="324" r="14" />
      <circle cx="456" cy="256" r="38" />
      <circle class="visual-fill" cx="456" cy="256" r="13" />
      <path d="M396 202v22h34M516 202v22h-34M396 310v-22h34M516 310v-22h-34" />
      <path class="visual-dash" d="M164 328c14 68 106 106 194 84" />
    </g>
  )}

  {visual === "agriculture" && (
    <g class="visual-symbol">
      <path d="M52 402c96-40 158 26 254 4 88-20 142 26 282-10" />
      <rect class="visual-fill" x="238" y="248" width="152" height="66" rx="16" />
      <path d="M314 248v-34" />
      <rect class="visual-fill" x="286" y="176" width="56" height="38" rx="12" />
      <circle cx="276" cy="330" r="26" />
      <circle cx="352" cy="330" r="26" />
      <path d="M390 268h26l32 30" />
      <circle class="visual-fill" cx="452" cy="302" r="9" />
      <path d="M486 372v-92" />
      <path d="M486 318c-32-6-44-32-44-32 28-6 44 12 44 32ZM486 334c32-6 44-30 44-30-28-6-44 10-44 30Z" />
      <path class="visual-dash" d="M286 176c-40-30-96-16-118 26M120 392c92-38 152 20 244 0" />
    </g>
  )}

  {visual === "retrieval" && (
    <g class="visual-symbol">
      <circle class="visual-fill" cx="130" cy="260" r="20" />
      <path d="M150 260c48 0 56-76 104-80M150 260h84M150 260c48 0 56 78 104 82" />
      <circle class="visual-fill" cx="266" cy="176" r="15" />
      <circle class="visual-fill" cx="252" cy="260" r="15" />
      <circle class="visual-fill" cx="266" cy="344" r="15" />
      <path d="M281 176c44 0 50-38 90-42M267 260c48 0 58-24 104-26M281 344c44 0 52 34 90 36" />
      <circle class="visual-fill" cx="388" cy="130" r="13" />
      <circle cx="388" cy="234" r="13" />
      <circle class="visual-fill" cx="388" cy="384" r="13" />
      <circle cx="388" cy="234" r="34" />
      <path d="M412 258l42 42" />
      <path class="visual-dash" d="M266 176c68-26 84 34 122 58M266 344c62 22 84-42 122-52" />
    </g>
  )}

  {visual === "healthcare" && (
    <g class="visual-symbol">
      <rect class="visual-fill" x="158" y="126" width="212" height="252" rx="26" />
      <path d="M196 186h136M196 226h104M196 266h136" />
      <path d="M264 306v58M235 335h58" />
      <rect class="visual-fill" x="392" y="196" width="150" height="182" rx="24" />
      <path d="M424 246h86M424 286h64" />
      <circle cx="467" cy="336" r="20" />
      <path d="M459 336h16M467 328v16" />
      <path d="M84 430h84l24-48 24 96 26-70 22 22h300" />
      <path class="visual-dash" d="M370 200c46-24 78 6 90 46" />
    </g>
  )}
</svg>
