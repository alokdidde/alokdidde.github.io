---
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="shell footer-main">
    <a class="footer-brand" href="/">{site.name}</a>
    <p>Robotics, physical AI, and systems built for the real world.</p>
    <div class="footer-social" aria-label="Social links">
      {site.social.map((item) => (
        <a href={item.href} target="_blank" rel="me noopener noreferrer">{item.label} ↗</a>
      ))}
      <a href="/rss.xml">RSS</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Alok Didde</span>
    <span>Designed for slow reading / built with Astro</span>
  </div>
</footer>
