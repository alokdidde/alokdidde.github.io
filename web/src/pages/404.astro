---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page does not exist.">
  <div class="measure page-main">
    <header class="page-header">
      <p class="section-label">Error / 404</p>
      <h1>Wrong turn.</h1>
      <p class="page-intro">
        This path doesn’t lead anywhere yet. The workshop is untidy like that.
      </p>
      <div class="hero-actions">
        <a class="button-link" href="/">Back home</a>
        <a class="text-link" href="/blog">Read the field notes →</a>
      </div>
    </header>
  </div>
</BaseLayout>
